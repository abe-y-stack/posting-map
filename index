<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>移動費見積り</title>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<style>
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:system-ui,-apple-system,"Hiragino Sans","Noto Sans JP",sans-serif;background:#fff;color:#111;font-size:16px;line-height:1.6;-webkit-text-size-adjust:100%}
.wrap{max-width:600px;margin:0 auto;padding:24px 20px 80px}

header{display:flex;justify-content:space-between;align-items:center;padding-bottom:20px;border-bottom:1px solid #111;margin-bottom:32px}
header h1{font-size:20px;font-weight:600;letter-spacing:.02em}
.icon-btn{width:40px;height:40px;border-radius:50%;border:1px solid #ddd;background:#fff;cursor:pointer;font-size:16px;display:flex;align-items:center;justify-content:center;transition:.15s}
.icon-btn:hover{background:#111;color:#fff;border-color:#111}

.block{margin-bottom:28px}
.label{font-size:12px;font-weight:600;letter-spacing:.08em;color:#666;margin-bottom:10px;text-transform:uppercase}

.field{position:relative}
.row{display:flex;gap:8px}
input[type=text],input[type=number]{width:100%;padding:14px;border:1px solid #ddd;border-radius:8px;font-size:16px;font-family:inherit;background:#fff;color:#111}
input:focus{outline:none;border-color:#111}
.mini-btn{flex:0 0 auto;padding:0 16px;border:1px solid #ddd;border-radius:8px;background:#fff;cursor:pointer;font-size:15px;transition:.15s}
.mini-btn:hover{background:#f2f2f2;border-color:#111}

.status{margin-top:8px;font-size:13px;display:flex;align-items:flex-start;gap:6px;min-height:20px}
.status.ok{color:#111}
.status.ng{color:#b00}
.status.wait{color:#888}
.dot{flex:0 0 auto;margin-top:7px;width:6px;height:6px;border-radius:50%;background:#111}
.status.ng .dot{background:#b00}
.status.wait .dot{background:#bbb}

.cand{position:absolute;z-index:900;left:0;right:0;top:100%;margin-top:4px;background:#fff;border:1px solid #111;border-radius:8px;overflow:hidden;box-shadow:0 8px 24px rgba(0,0,0,.12);display:none}
.cand.on{display:block}
.cand-item{padding:12px 14px;cursor:pointer;font-size:14px;border-bottom:1px solid #f0f0f0}
.cand-item:last-child{border-bottom:none}
.cand-item:hover,.cand-item.sel{background:#f2f2f2}
.cand-src{font-size:11px;color:#888;margin-left:6px}
.cand-empty{padding:14px;font-size:13px;color:#888}

.tabs{display:flex;border-bottom:1px solid #e5e5e5}
.tab{flex:1;padding:14px 4px;background:none;border:none;border-bottom:2px solid transparent;margin-bottom:-1px;font-size:14px;font-family:inherit;color:#999;cursor:pointer;transition:.15s}
.tab.on{color:#111;border-bottom-color:#111;font-weight:600}

.acc-head{width:100%;display:flex;justify-content:space-between;align-items:center;padding:14px 0;background:none;border:none;border-top:1px solid #e5e5e5;font-size:14px;font-family:inherit;font-weight:600;color:#111;cursor:pointer}
.acc-head .arw{transition:.2s}
.acc-head.on .arw{transform:rotate(90deg)}
.acc-body{display:none;padding:4px 0 16px}
.acc-body.on{display:block}
.frow{display:flex;align-items:center;gap:12px;margin-bottom:12px}
.frow label{flex:0 0 130px;font-size:13px;color:#555}
.frow input{flex:1}
.chk{display:flex;align-items:center;gap:10px;margin-bottom:12px;font-size:14px}
.chk input{width:18px;height:18px;accent-color:#111;flex:0 0 auto}

.btn{width:100%;padding:16px;background:#111;color:#fff;border:none;border-radius:999px;font-size:16px;font-family:inherit;font-weight:600;cursor:pointer;transition:.15s;display:flex;align-items:center;justify-content:center;gap:10px}
.btn:hover:not(:disabled){background:#333}
.btn:disabled{background:#ccc;cursor:not-allowed}
.spin{width:15px;height:15px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:sp .7s linear infinite;display:none}
.btn.busy .spin{display:block}
@keyframes sp{to{transform:rotate(360deg)}}

#map{width:100%;height:260px;border:1px solid #e5e5e5;border-radius:8px;background:#f7f7f7;margin-bottom:24px}

.card{border:1px solid #111;border-radius:12px;padding:20px;margin-bottom:20px}
.card h3{font-size:15px;font-weight:600;padding-bottom:14px;border-bottom:1px solid #e5e5e5;margin-bottom:16px;display:flex;justify-content:space-between;align-items:baseline}
.src-tag{font-size:11px;font-weight:400;color:#888}
.line{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:7px 0;font-size:14px}
.line .k{color:#666;flex:1 1 auto}
.line .v{font-weight:600;text-align:right;white-space:nowrap}
.line input{width:110px;padding:9px 10px;font-size:14px;text-align:right}
.line a.ext{font-size:12px;padding:9px 11px;border:1px solid #ddd;border-radius:8px;text-decoration:none;color:#111;white-space:nowrap}
.line a.ext:hover{background:#111;color:#fff;border-color:#111}
.sep{border-top:1px solid #e5e5e5;margin:14px 0}
.total{background:#111;color:#fff;border-radius:8px;padding:14px 16px;margin-top:14px}
.total .line{padding:0;font-size:16px}
.total .k{color:rgba(255,255,255,.7)}
.total .v{font-size:20px}
.note{font-size:12px;color:#888;margin-top:12px;line-height:1.5}

.acts{display:flex;gap:8px;margin-top:16px}
.act{flex:1;padding:13px;border:1px solid #ddd;border-radius:999px;background:#fff;font-size:13px;font-family:inherit;font-weight:600;cursor:pointer;transition:.15s}
.act:hover{background:#111;color:#fff;border-color:#111}

.item{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px;border:1px solid #e5e5e5;border-radius:8px;margin-bottom:8px}
.item-main{flex:1;min-width:0;cursor:pointer}
.item-t{font-size:14px;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.item-s{font-size:12px;color:#888;margin-top:3px}
.item-x{flex:0 0 auto;width:32px;height:32px;border:1px solid #e5e5e5;border-radius:6px;background:#fff;cursor:pointer;font-size:13px}
.item-x:hover{background:#111;color:#fff}
.empty{padding:28px 0;text-align:center;color:#aaa;font-size:13px}

.modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.45);z-index:1000;align-items:center;justify-content:center;padding:20px}
.modal.on{display:flex}
.modal-in{background:#fff;border-radius:14px;padding:24px;width:100%;max-width:520px;max-height:85vh;overflow-y:auto}
.modal-h{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.modal-h span{font-size:16px;font-weight:600}
.modal-x{width:32px;height:32px;border:none;background:none;font-size:20px;cursor:pointer;color:#999}
.modal-f{display:flex;gap:8px;margin-top:20px}
.modal-b{flex:1;padding:13px;border-radius:999px;border:1px solid #ddd;background:#fff;font-size:14px;font-family:inherit;font-weight:600;cursor:pointer}
.modal-b.pri{background:#111;color:#fff;border-color:#111}

.diag{font-size:13px;border:1px solid #e5e5e5;border-radius:8px;padding:14px;margin-bottom:14px}
.diag-row{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #f2f2f2}
.diag-row:last-child{border-bottom:none}
.diag-ok{color:#0a0;font-weight:600}
.diag-ng{color:#b00;font-weight:600}
.diag-wait{color:#999}

.toast{position:fixed;left:20px;right:20px;bottom:24px;max-width:560px;margin:0 auto;background:#111;color:#fff;padding:14px 18px;border-radius:10px;font-size:14px;z-index:2000;display:none;box-shadow:0 8px 30px rgba(0,0,0,.25)}
.toast.on{display:block}
.toast.ng{background:#b00}

@media(max-width:600px){
.wrap{padding:20px 16px 60px}
.frow{flex-wrap:wrap}
.frow label{flex:1 1 100%}
.line{flex-wrap:wrap}
.line input{width:100%}
.line a.ext{width:100%;text-align:center}
}
</style>
</head>
<body>
<div class="wrap">

<header>
  <h1>移動費見積り</h1>
  <button class="icon-btn" id="btnSettings" title="設定・接続診断">⚙</button>
</header>

<!-- 出発地 -->
<div class="block">
  <div class="label">出発地</div>
  <div class="field">
    <div class="row">
      <input type="text" id="inOrigin" placeholder="住所・駅名・施設名" autocomplete="off">
      <button class="mini-btn" id="btnGps" title="現在地">現在地</button>
      <button class="mini-btn" id="btnFavO" title="お気に入り">★</button>
    </div>
    <div class="cand" id="candOrigin"></div>
    <div class="status wait" id="stOrigin"><span class="dot"></span><span>未確定</span></div>
  </div>
</div>

<!-- 訪問先 -->
<div class="block">
  <div class="label">訪問先</div>
  <div class="field">
    <div class="row">
      <input type="text" id="inDest" placeholder="住所・駅名・施設名" autocomplete="off">
      <button class="mini-btn" id="btnFavD" title="お気に入り">★</button>
    </div>
    <div class="cand" id="candDest"></div>
    <div class="status wait" id="stDest"><span class="dot"></span><span>未確定</span></div>
  </div>
</div>

<!-- 交通手段 -->
<div class="block">
  <div class="tabs" id="modeTabs">
    <button class="tab on" data-mode="car">車</button>
    <button class="tab" data-mode="transit">電車</button>
    <button class="tab" data-mode="walk">徒歩</button>
    <button class="tab" data-mode="bike">自転車</button>
  </div>
</div>

<!-- 設定 -->
<div class="block">
  <button class="acc-head" id="accVehicle"><span>車両・経費設定</span><span class="arw">›</span></button>
  <div class="acc-body" id="accVehicleBody">
    <div class="frow"><label>燃費 (km/L)</label><input type="number" id="cfgEff" step="0.1" min="1" value="12"></div>
    <div class="frow"><label>ガソリン単価 (円/L)</label><input type="number" id="cfgPrice" step="1" min="1" value="175"></div>
    <div class="frow"><label>会社規定 (円/km)</label><input type="number" id="cfgRate" step="1" min="0" placeholder="任意"></div>
    <div class="chk"><input type="checkbox" id="cfgRound" checked><label for="cfgRound">往復で計算する</label></div>
    <div class="chk"><input type="checkbox" id="cfgAvoidToll"><label for="cfgAvoidToll">高速道路を使わないルートで検索</label></div>
  </div>

  <button class="acc-head" id="accManual"><span>距離を手入力する（API不調時）</span><span class="arw">›</span></button>
  <div class="acc-body" id="accManualBody">
    <div class="frow"><label>片道距離 (km)</label><input type="number" id="manDist" step="0.1" min="0" placeholder="例 16.4"></div>
    <div class="frow"><label>片道所要 (分)</label><input type="number" id="manMin" step="1" min="0" placeholder="例 35"></div>
    <button class="act" id="btnManual" style="width:100%">この距離で計算する</button>
    <div class="note">検索が失敗する場合や、実際の走行距離が分かっている場合はこちらから直接計算できます。住所の確定は不要です。</div>
  </div>
</div>

<div class="block">
  <button class="btn" id="btnSearch"><span class="spin"></span><span id="btnSearchTxt">ルートを検索</span></button>
</div>

<div id="map"></div>

<!-- 結果 -->
<div id="result"></div>

<!-- 履歴・お気に入り -->
<div class="block">
  <div class="tabs" id="listTabs">
    <button class="tab on" data-list="hist">履歴</button>
    <button class="tab" data-list="fav">お気に入り</button>
  </div>
  <div id="listBody" style="margin-top:16px"></div>
  <div class="acts" id="listActs" style="display:none">
    <button class="act" id="btnCsv">CSV出力</button>
    <button class="act" id="btnClearHist">履歴を全消去</button>
  </div>
</div>

</div>

<!-- 設定モーダル -->
<div class="modal" id="mdSettings">
  <div class="modal-in">
    <div class="modal-h"><span>設定・接続診断</span><button class="modal-x" data-close="mdSettings">✕</button></div>

    <div class="label">接続診断</div>
    <div class="diag" id="diagBox">
      <div class="diag-row"><span>国土地理院 住所検索</span><span class="diag-wait" id="dgGsi">未実行</span></div>
      <div class="diag-row"><span>Nominatim 検索</span><span class="diag-wait" id="dgNom">未実行</span></div>
      <div class="diag-row"><span>OSRM ルート探索</span><span class="diag-wait" id="dgOsrm">未実行</span></div>
      <div class="diag-row"><span>地図タイル / Leaflet</span><span class="diag-wait" id="dgLeaf">未実行</span></div>
    </div>
    <button class="act" id="btnDiag" style="width:100%">診断を実行</button>
    <div class="note" id="diagNote"></div>

    <div class="sep"></div>
    <div class="note">
      本ツールは国土地理院API・OpenStreetMap・OSRM を利用しています（APIキー不要・無料）。<br>
      高速料金と電車運賃は自動取得せず、外部サイトで確認して手入力する方式です。<br>
      公開APIは低頻度利用を前提としています。連続した大量検索は避けてください。
    </div>
    <div class="modal-f"><button class="modal-b" data-close="mdSettings">閉じる</button></div>
  </div>
</div>

<!-- お気に入り選択 -->
<div class="modal" id="mdFav">
  <div class="modal-in">
    <div class="modal-h"><span id="mdFavTitle">お気に入り</span><button class="modal-x" data-close="mdFav">✕</button></div>
    <div id="mdFavList"></div>
    <div class="modal-f"><button class="modal-b" data-close="mdFav">閉じる</button></div>
  </div>
</div>

<!-- お気に入り登録 -->
<div class="modal" id="mdAddFav">
  <div class="modal-in">
    <div class="modal-h"><span>お気に入りに登録</span><button class="modal-x" data-close="mdAddFav">✕</button></div>
    <div class="frow" style="display:block"><label style="display:block;margin-bottom:6px">表示名</label><input type="text" id="favLabel" placeholder="例：〇〇工務店"></div>
    <div class="frow" style="display:block;margin-top:12px"><label style="display:block;margin-bottom:6px">住所</label><input type="text" id="favAddr" readonly></div>
    <div class="modal-f">
      <button class="modal-b pri" id="btnSaveFav">登録</button>
      <button class="modal-b" data-close="mdAddFav">キャンセル</button>
    </div>
  </div>
</div>

<div class="toast" id="toast"></div>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
/* =========================================================================
   Core : 純粋関数のみ。DOM・ネットワークに依存しない（テスト対象）
   ========================================================================= */
const Core = {

  /** 2点間の大圏距離(km) */
  haversineKm(a, b){
    const R = 6371, r = Math.PI/180;
    const dLat = (b.lat-a.lat)*r, dLng = (b.lng-a.lng)*r;
    const s = Math.sin(dLat/2)**2 + Math.cos(a.lat*r)*Math.cos(b.lat*r)*Math.sin(dLng/2)**2;
    return 2*R*Math.asin(Math.min(1, Math.sqrt(s)));
  },

  /** 車の費用計算。金額は円単位で四捨五入 */
  carCost({distanceKm, fuelEff, fuelPrice, tollOneWay=0, companyRate=null, roundTrip=true}){
    const mul  = roundTrip ? 2 : 1;
    const dist = distanceKm * mul;
    const fuel = (fuelEff > 0) ? Math.round(distanceKm / fuelEff * fuelPrice) * mul : 0;
    const toll = Math.round(tollOneWay) * mul;
    const company = (companyRate != null && companyRate > 0) ? Math.round(dist * companyRate) : null;
    return {
      distanceTotal: Math.round(dist*10)/10,
      fuel, toll,
      total: fuel + toll,
      company,
      diff: (company != null) ? company - (fuel + toll) : null
    };
  },

  /** 電車の費用計算 */
  transitCost({fareOneWay=0, roundTrip=true}){
    const mul = roundTrip ? 2 : 1;
    return { fare: Math.round(fareOneWay)*mul, total: Math.round(fareOneWay)*mul };
  },

  /** 徒歩・自転車の所要時間概算(分)。道路距離から速度モデルで算出 */
  estimateMinutes(distanceKm, mode){
    const kmh = (mode === 'walk') ? 4.8 : 15;
    return Math.max(1, Math.round(distanceKm / kmh * 60));
  },

  /** 国土地理院APIレスポンス → 共通候補形式 */
  normalizeGsi(json){
    if (!Array.isArray(json)) return [];
    return json.map(f => {
      const c = f && f.geometry && f.geometry.coordinates;
      if (!Array.isArray(c) || c.length < 2) return null;
      const lng = Number(c[0]), lat = Number(c[1]);
      if (!isFinite(lat) || !isFinite(lng)) return null;
      const title = (f.properties && f.properties.title) ? String(f.properties.title) : '';
      if (!title) return null;
      return { lat, lng, address: title, source: '地理院' };
    }).filter(Boolean);
  },

  /** Nominatimレスポンス → 共通候補形式 */
  normalizeNominatim(json){
    if (!Array.isArray(json)) return [];
    return json.map(f => {
      const lat = Number(f.lat), lng = Number(f.lon);
      if (!isFinite(lat) || !isFinite(lng)) return null;
      const name = f.display_name ? String(f.display_name).replace(/, 日本$/, '') : '';
      if (!name) return null;
      return { lat, lng, address: name, source: 'OSM' };
    }).filter(Boolean);
  },

  /** 候補の重複排除。約100m以内の同一地点は1件に丸める */
  dedupe(list){
    const out = [];
    for (const c of list){
      const dup = out.some(o => Math.abs(o.lat-c.lat) < 0.001 && Math.abs(o.lng-c.lng) < 0.001);
      if (!dup) out.push(c);
    }
    return out;
  },

  /** OSRMレスポンス(geometries=geojson) → ルート形式。座標は[lat,lng]配列で返す */
  parseOsrm(json){
    if (!json || json.code !== 'Ok' || !Array.isArray(json.routes) || json.routes.length === 0){
      throw new Error('ルートが見つかりません');
    }
    const r = json.routes[0];
    const coords = (r.geometry && Array.isArray(r.geometry.coordinates)) ? r.geometry.coordinates : [];
    return {
      distanceKm: Math.round(r.distance/100)/10,
      durationMin: Math.max(1, Math.round(r.duration/60)),
      path: coords.map(p => [Number(p[1]), Number(p[0])]).filter(p => isFinite(p[0]) && isFinite(p[1])),
      source: 'osrm'
    };
  },

  /** CSV文字列を生成（RFC4180準拠のクォート） */
  buildCsv(rows){
    const esc = v => '"' + String(v==null?'':v).replace(/"/g,'""') + '"';
    return rows.map(r => r.map(esc).join(',')).join('\r\n');
  },

  /** 履歴レコード → CSV行 */
  historyToRows(items){
    const head = ['日付','出発地','訪問先','手段','距離km','所要分','高速料金','ガソリン代','運賃','合計'];
    const body = items.map(h => [
      new Date(h.date).toLocaleDateString('ja-JP'),
      h.origin, h.dest,
      ({car:'車',transit:'電車',walk:'徒歩',bike:'自転車'})[h.mode] || h.mode,
      h.distanceKm ?? '', h.durationMin ?? '',
      h.toll ?? '', h.fuel ?? '', h.fare ?? '', h.total ?? ''
    ]);
    return [head, ...body];
  },

  yen(n){ return (n==null) ? '—' : '¥' + Number(n).toLocaleString('ja-JP'); }
};

/* =========================================================================
   Services : ネットワーク層
   ========================================================================= */
const Net = {
  async json(url, opt={}){
    const ctl = new AbortController();
    const timer = setTimeout(() => ctl.abort(), opt.timeout || 12000);
    try{
      const res = await fetch(url, {signal: ctl.signal, headers: opt.headers || {}});
      if (!res.ok) throw new Error('HTTP ' + res.status);
      return await res.json();
    } finally { clearTimeout(timer); }
  }
};

const GeoService = {
  GSI: 'https://msearch.gsi.go.jp/address-search/AddressSearch',
  NOM: 'https://nominatim.openstreetmap.org/search',

  /** 地理院とNominatimを併用して候補を返す。片方が落ちても継続する */
  async search(q){
    const query = String(q||'').trim();
    if (query.length < 2) return [];
    const tasks = [
      Net.json(`${this.GSI}?q=${encodeURIComponent(query)}`).then(Core.normalizeGsi).catch(()=>[]),
      Net.json(`${this.NOM}?q=${encodeURIComponent(query)}&format=json&limit=5&countrycodes=jp&accept-language=ja`)
        .then(Core.normalizeNominatim).catch(()=>[])
    ];
    const [gsi, nom] = await Promise.all(tasks);
    return Core.dedupe([...gsi.slice(0,5), ...nom.slice(0,5)]).slice(0,8);
  },

  async reverse(lat, lng){
    try{
      const j = await Net.json(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&accept-language=ja&zoom=18`);
      if (j && j.display_name) return String(j.display_name).replace(/, 日本$/,'');
    }catch(e){}
    return `緯度${lat.toFixed(5)} 経度${lng.toFixed(5)}`;
  }
};

const RouteService = {
  BASE: 'https://router.project-osrm.org/route/v1',

  /** OSRM公開サーバは車プロファイルのみ稼働。徒歩・自転車は道路距離から速度換算する */
  async route(from, to, mode, avoidToll){
    const coords = `${from.lng},${from.lat};${to.lng},${to.lat}`;
    const url = `${this.BASE}/driving/${coords}?overview=full&geometries=geojson&alternatives=false&steps=false`;
    try{
      const json = await Net.json(url);
      const r = Core.parseOsrm(json);
      if (mode === 'walk' || mode === 'bike') r.source = 'osrm-est';
      if (avoidToll) r.avoidTollRequested = true;
      return r;
    }catch(e){
      // 経路探索が失敗した場合は直線距離に迂回係数1.3を掛けた概算にフォールバック
      const straight = Core.haversineKm(from, to);
      const km = Math.round(straight * 1.3 * 10)/10;
      const spd = {car:32, transit:32, walk:4.8, bike:15}[mode] || 32;
      return {
        distanceKm: km,
        durationMin: Math.max(1, Math.round(km/spd*60)),
        path: [[from.lat,from.lng],[to.lat,to.lng]],
        source: 'fallback',
        error: e.message
      };
    }
  }
};

const LinkBuilder = {
  toll(){ return 'https://www.driveplaza.com/dp/SearchTop'; },
  transit(from, to){
