  }
};

/* =========================================================================
   Store : LocalStorage
   ========================================================================= */
class Store {
  constructor(key, init){ this.key = key; this.init = init; }
  // structuredClone は古いブラウザで未実装のため使用しない
  clone(o){ return JSON.parse(JSON.stringify(o)); }
  get(){
    try{ const v = localStorage.getItem(this.key); return v ? JSON.parse(v) : this.clone(this.init); }
    catch(e){ return this.clone(this.init); }
  }
  set(v){ try{ localStorage.setItem(this.key, JSON.stringify(v)); }catch(e){} }
}
