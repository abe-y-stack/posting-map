<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>在庫・棚卸</title>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

:root {
  --bg: #FFFFFF;
  --surface: #F6F6F4;
  --surface2: #EDEDEA;
  --border: rgba(0,0,0,0.09);
  --t1: #111111;
  --t2: #6E6E73;
  --t3: #AEAEB2;
  --ok: #4C7A5A;
  --warn: #B0713C;
  --bad: #A4453F;
  --nav-h: 62px;
  --head-h: 52px;
  --radius: 14px;
  font-size: 16px;
}

html, body { height: 100%; overflow: hidden; }
body {
  font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Noto Sans JP", sans-serif;
  background: var(--bg); color: var(--t1);
  -webkit-font-smoothing: antialiased;
}
button { font-family: inherit; border: none; background: none; cursor: pointer; color: inherit; }
input, select { font-family: inherit; font-size: 16px; }

/* ── Header ── */
#header {
  position: fixed; top: 0; left: 0; right: 0; height: var(--head-h);
  display: flex; align-items: center; gap: 10px; padding: 0 14px;
  background: rgba(255,255,255,0.92); backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border); z-index: 50;
}
#header .title { font-size: 16px; font-weight: 700; letter-spacing: 0.02em; }
#conn { display: flex; align-items: center; gap: 5px; font-size: 11px; color: var(--t2); }
#conn .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--t3); }
#conn.on .dot { background: var(--ok); }
#header .sp { flex: 1; }
.icon-btn {
  width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  background: var(--surface);
}
.icon-btn svg { width: 17px; height: 17px; stroke: var(--t1); stroke-width: 2; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.icon-btn:active { background: var(--surface2); }

/* ── Panels ── */
.panel {
  position: fixed; top: var(--head-h); bottom: calc(var(--nav-h) + env(safe-area-inset-bottom));
  left: 0; right: 0; display: none; overflow-y: auto; -webkit-overflow-scrolling: touch;
}
.panel.active { display: block; }
/* ── Generic list ── */
.p-inner { padding: 14px 14px 30px; max-width: 760px; margin: 0 auto; }
.sec-label { font-size: 11px; font-weight: 700; color: var(--t2); letter-spacing: 0.08em; margin: 18px 4px 8px; }
.card-list { background: var(--surface); border-radius: var(--radius); overflow: hidden; }
.row {
  display: flex; align-items: center; gap: 11px; padding: 12px 14px;
  border-bottom: 1px solid var(--border); cursor: pointer;
}
.row:last-child { border-bottom: none; }
.row:active { background: var(--surface2); }
.row .swatch { width: 12px; height: 12px; border-radius: 4px; flex-shrink: 0; }
.row .meta { flex: 1; min-width: 0; }
.row .nm { font-size: 14px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.row .cd { font-size: 11px; color: var(--t2); margin-top: 1px; }
.row .num { text-align: right; flex-shrink: 0; }
.row .num b { font-size: 17px; font-weight: 700; }
.row .num span { font-size: 10px; color: var(--t2); display: block; margin-top: -1px; }
.row .chev { color: var(--t3); font-size: 15px; flex-shrink: 0; }
/* search bar */
.s-bar {
  display: flex; align-items: center; gap: 8px; background: var(--surface);
  border-radius: 12px; padding: 9px 12px; margin-bottom: 12px;
}
.s-bar svg { width: 15px; height: 15px; stroke: var(--t2); stroke-width: 2.2; fill: none; flex-shrink: 0; }
.s-bar input { flex: 1; border: none; background: none; outline: none; font-size: 15px; }

/* pill buttons */
.pill {
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  background: var(--t1); color: #fff; border-radius: 999px;
  padding: 12px 20px; font-size: 14px; font-weight: 600;
}
.pill:active { opacity: 0.75; }
.pill.ghost { background: var(--surface); color: var(--t1); }
.pill.full { width: 100%; }
.pill:disabled { opacity: 0.35; }
.pill.danger { background: #fff; color: var(--bad); border: 1px solid var(--border); }

/* ── 棚卸 panel ── */
#scan-idle { text-align: center; padding: 46px 20px 20px; }
#scan-idle .big { font-size: 17px; font-weight: 700; margin-bottom: 6px; }
#scan-idle .sub { font-size: 13px; color: var(--t2); line-height: 1.7; margin-bottom: 24px; }

#scan-live { display: none; }
#cam-wrap {
  position: relative; border-radius: var(--radius); overflow: hidden;
  background: #111; aspect-ratio: 4 / 3; margin-bottom: 12px;
}
#cam { width: 100%; height: 100%; object-fit: cover; }
#cam-frame {
  position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none;
}
#cam-frame .box { width: 58%; aspect-ratio: 1; border: 2px solid rgba(255,255,255,0.85); border-radius: 16px; }
#cam-flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; transition: opacity 0.25s; }
#cam-off-msg { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; color: #999; font-size: 13px; }

.count-head { display: flex; align-items: baseline; gap: 8px; margin: 16px 4px 8px; }
.count-head .t { font-size: 11px; font-weight: 700; color: var(--t2); letter-spacing: 0.08em; flex: 1; }
.count-head .n { font-size: 12px; color: var(--t2); }

.tally-row { display: flex; align-items: center; gap: 10px; padding: 11px 14px; border-bottom: 1px solid var(--border); }
.tally-row:last-child { border-bottom: none; }
.tally-row .meta { flex: 1; min-width: 0; }
.tally-row .nm { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tally-row .cd { font-size: 10px; color: var(--t2); }
.tally-row .cnt { font-size: 16px; font-weight: 700; }
.tally-row .vs { font-size: 11px; color: var(--t2); }
.diff-chip { font-size: 11px; font-weight: 700; border-radius: 6px; padding: 2px 7px; }
.diff-chip.zero { background: var(--surface2); color: var(--t2); }
.diff-chip.plus { background: rgba(76,122,90,0.13); color: var(--ok); }
.diff-chip.minus { background: rgba(164,69,63,0.12); color: var(--bad); }

.hist-row { display: flex; align-items: center; gap: 8px; padding: 9px 14px; border-bottom: 1px solid var(--border); font-size: 12px; }
.hist-row:last-child { border-bottom: none; }
.hist-row .m { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: var(--t2); }
.hist-row .q { font-weight: 700; }
.hist-row .del { color: var(--bad); font-size: 12px; padding: 4px 8px; }

/* ── Sheets(modal) ── */
#sheet-bg {
  position: fixed; inset: 0; background: rgba(0,0,0,0.35); z-index: 90;
  opacity: 0; pointer-events: none; transition: opacity 0.22s;
}
#sheet-bg.show { opacity: 1; pointer-events: auto; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 95;
  background: var(--bg); border-radius: 20px 20px 0 0;
  max-height: 88%; overflow-y: auto; -webkit-overflow-scrolling: touch;
  transform: translateY(105%); transition: transform 0.28s cubic-bezier(0.32,0.72,0,1);
  padding: 10px 18px calc(26px + env(safe-area-inset-bottom));
  max-width: 640px; margin: 0 auto;
}
.sheet.show { transform: translateY(0); }
.sheet .handle { width: 38px; height: 5px; border-radius: 3px; background: var(--surface2); margin: 4px auto 14px; }
.sheet h2 { font-size: 17px; font-weight: 700; margin-bottom: 16px; }
.f-group { margin-bottom: 14px; }
.f-label { font-size: 11px; font-weight: 700; color: var(--t2); letter-spacing: 0.06em; margin-bottom: 6px; }
.f-input { width: 100%; border: 1px solid var(--border); border-radius: 11px; padding: 11px 13px; font-size: 15px; background: var(--bg); outline: none; }
textarea.f-input { resize: vertical; font-family: inherit; line-height: 1.5; }
.f-input:focus { border-color: var(--t1); }
.f-hint { font-size: 11px; color: var(--t2); margin-top: 5px; line-height: 1.6; }
.f-row { display: flex; gap: 10px; }
.f-row > * { flex: 1; }
.swatches { display: flex; gap: 9px; flex-wrap: wrap; }
.swatches .sw { width: 30px; height: 30px; border-radius: 9px; border: 2px solid transparent; }
.swatches .sw.sel { border-color: var(--t1); }

/* Summary modal */
.sum-table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 14px; }
.sum-table th { text-align: right; font-size: 10px; color: var(--t2); font-weight: 600; padding: 6px 6px; border-bottom: 1px solid var(--border); }
.sum-table th:first-child { text-align: left; }
.sum-table td { padding: 8px 6px; border-bottom: 1px solid var(--border); text-align: right; }
.sum-table td:first-child { text-align: left; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.check-line { display: flex; align-items: center; gap: 9px; font-size: 13px; margin: 6px 2px 16px; }
.check-line input { width: 18px; height: 18px; accent-color: #111; }

/* ── Label print items ── */
.label-card {
  background: var(--surface); border-radius: 12px; padding: 12px 14px;
  display: flex; align-items: center; gap: 11px; margin-bottom: 8px;
}
.label-card input[type=checkbox] { width: 19px; height: 19px; accent-color: #111; flex-shrink: 0; }
.label-card .meta { flex: 1; min-width: 0; }
.label-card .nm { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.label-card .sub { font-size: 11px; color: var(--t2); margin-top: 1px; }
.label-card .void { font-size: 11px; color: var(--bad); padding: 5px 8px; flex-shrink: 0; }

/* ── Bottom nav ── */
#nav {
  position: fixed; bottom: 0; left: 0; right: 0; z-index: 50;
  height: calc(var(--nav-h) + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255,255,255,0.94); backdrop-filter: blur(12px);
  border-top: 1px solid var(--border);
  display: flex;
}
.tab { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 3px; color: var(--t3); }
.tab svg { width: 21px; height: 21px; stroke: currentColor; stroke-width: 1.9; fill: none; stroke-linecap: round; stroke-linejoin: round; }
.tab span { font-size: 10px; font-weight: 600; }
.tab.on { color: var(--t1); }

/* toast */
#toast {
  position: fixed; bottom: calc(var(--nav-h) + 22px); left: 50%; transform: translateX(-50%) translateY(8px);
  background: rgba(17,17,17,0.92); color: #fff; font-size: 13px; font-weight: 500;
  border-radius: 999px; padding: 10px 20px; z-index: 200; white-space: nowrap;
  opacity: 0; pointer-events: none; transition: all 0.25s;
}
#toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

/* picker */
.picker-list { max-height: 46vh; overflow-y: auto; border: 1px solid var(--border); border-radius: 12px; }

/* ── Print ── */
#print-area { display: none; }
@media print {
  body > *:not(#print-area) { display: none !important; }
  html, body { overflow: visible; height: auto; }
  #print-area { display: block; }
  .pl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .pl {
    border: 1px dashed #999; padding: 5mm; display: flex; gap: 5mm; align-items: center;
    break-inside: avoid; height: 40mm;
  }
  .pl .qr { width: 28mm; height: 28mm; flex-shrink: 0; }
  .pl .qr img, .pl .qr canvas { width: 28mm !important; height: 28mm !important; }
  .pl .tx { flex: 1; min-width: 0; }
  .pl .tx .n { font-size: 10.5pt; font-weight: 700; line-height: 1.3; }
  .pl .tx .c { font-size: 7.5pt; color: #555; margin-top: 1mm; }
  .pl .tx .q { font-size: 14pt; font-weight: 800; margin-top: 1.5mm; }
  .pl .tx .id { font-size: 6.5pt; color: #999; margin-top: 1mm; }
}
</style>
</head>
<body>

<header id="header">
  <div class="title">在庫・棚卸</div>
  <div id="conn"><div class="dot"></div><span id="conn-tx">未接続</span></div>
  <div class="sp"></div>
  <button class="icon-btn" onclick="reloadData()" title="再読込">
    <svg viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-2.6-6.4M21 3v6h-6"/></svg>
  </button>
  <button class="icon-btn" onclick="openSettings()" title="設定">
    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.2a1.7 1.7 0 0 0-1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.2a1.7 1.7 0 0 0 1.5-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3h.1a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.2a1.7 1.7 0 0 0 1 1.5h.1a1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9v.1a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.2a1.7 1.7 0 0 0-1.4 1Z"/></svg>
  </button>
</header>

<!-- ═══ 在庫一覧 ═══ -->
<div class="panel active" id="panel-list">
  <div class="p-inner">
    <div class="s-bar">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input id="list-search" placeholder="商品名・コードで検索" oninput="renderList()">
    </div>
    <div style="display:flex; gap:9px; margin-bottom:6px;">
      <button class="pill ghost" style="flex:1" onclick="document.getElementById('csv-file').click()">CSVインポート</button>
      <button class="pill ghost" style="flex:1" onclick="openProductEdit(null)">商品を追加</button>
    </div>
    <input type="file" id="csv-file" accept=".csv" style="display:none" onchange="importCsv(this.files[0])">
    <div class="sec-label" id="list-count-label">商品</div>
    <div class="card-list" id="list-el"></div>
  </div>
</div>

<!-- ═══ 棚卸 ═══ -->
<div class="panel" id="panel-count">
  <div class="p-inner">
    <div id="scan-idle">
      <div class="big">棚卸を開始</div>
      <div class="sub">ダンボールのQRラベルをスキャンすると<br>入数分が自動で加算されます</div>
      <button class="pill full" onclick="startSession()">棚卸を開始する</button>
      <div id="resume-box" style="display:none; margin-top:12px;">
        <button class="pill ghost full" onclick="resumeSession()">前回の続きから再開</button>
      </div>
    </div>

    <div id="scan-live">
      <div id="cam-wrap">
        <video id="cam" playsinline muted></video>
        <div id="cam-frame"><div class="box"></div></div>
        <div id="cam-flash"></div>
        <div id="cam-off-msg">カメラ停止中</div>
      </div>
      <div style="display:flex; gap:9px;">
        <button class="pill ghost" style="flex:1" id="cam-toggle" onclick="toggleCamera()">カメラ停止</button>
        <button class="pill ghost" style="flex:1" onclick="manualAdd()">手入力で追加</button>
      </div>

      <div class="count-head"><div class="t">カウント状況（実数 / 理論）</div><div class="n" id="tally-n"></div></div>
      <div class="card-list" id="tally-el"></div>

      <div class="count-head"><div class="t">スキャン履歴</div></div>
      <div class="card-list" id="hist-el"></div>

      <div style="margin-top:20px; display:flex; flex-direction:column; gap:9px;">
        <button class="pill full" onclick="openSummary()">棚卸を完了する</button>
        <button class="pill danger full" onclick="cancelSession()">中断して破棄</button>
      </div>
    </div>
  </div>
</div>

<!-- ═══ ラベル ═══ -->
<div class="panel" id="panel-label">
  <div class="p-inner">
    <div class="sec-label">QRラベルを発行</div>
    <div style="background:var(--surface); border-radius:var(--radius); padding:14px;">
      <div class="f-group">
        <div class="f-label">商品</div>
        <button class="f-input" style="text-align:left; color:var(--t2);" id="lb-product-btn" onclick="pickProduct(p => setLabelProduct(p))">タップして商品を選択</button>
      </div>

      <div class="f-group">
        <div class="f-label">発行方法</div>
        <div style="display:flex; gap:8px;">
          <button class="pill ghost full" id="lb-mode-uniform" style="background:var(--t1);color:#fff;" onclick="setLabelMode('uniform')">同じ入数で複数箱</button>
          <button class="pill ghost full" id="lb-mode-custom" onclick="setLabelMode('custom')">箱ごとに数が違う</button>
        </div>
      </div>

      <div id="lb-uniform-fields">
        <div class="f-row">
          <div class="f-group">
            <div class="f-label">入数（1箱あたり）</div>
            <input class="f-input" id="lb-qty" type="number" inputmode="numeric" min="1" placeholder="20">
          </div>
          <div class="f-group">
            <div class="f-label">枚数（箱の数）</div>
            <input class="f-input" id="lb-count" type="number" inputmode="numeric" min="1" value="1">
          </div>
        </div>
      </div>

      <div id="lb-custom-fields" style="display:none;">
        <div class="f-group">
          <div class="f-label">合計から自動割付（任意）</div>
          <div class="f-row">
            <input class="f-input" id="lb-total" type="number" inputmode="numeric" placeholder="合計 例:62">
            <input class="f-input" id="lb-std" type="number" inputmode="numeric" placeholder="標準入数 例:20">
          </div>
          <button class="pill ghost full" style="margin-top:8px;" onclick="autoSplitLabels()">下欄に割り付ける</button>
        </div>
        <div class="f-group">
          <div class="f-label">箱ごとの入数（カンマまたは改行区切り）</div>
          <textarea class="f-input" id="lb-list" rows="3" placeholder="例：20,20,20,2　（1行=1箱でもOK）" oninput="renderLbPreview()"></textarea>
          <div class="f-hint" id="lb-preview"></div>
        </div>
      </div>

      <button class="pill full" onclick="createLabelsAction()">発行して印刷プレビュー</button>
      <div class="f-hint">スキャン1回で入数分が加算されます。ラベル1枚ごとに固有IDが付くため、同じ箱の二重スキャンは自動で弾かれます。</div>
    </div>

    <div class="sec-label">発行済みラベル</div>
    <div class="s-bar">
      <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
      <input id="label-search" placeholder="商品名・コードで絞り込み" oninput="renderLabels()">
    </div>
    <button class="pill ghost full" id="print-sel-btn" style="margin-bottom:10px;" onclick="printSelectedLabels()">選択したラベルを印刷</button>
    <div id="labels-el"></div>
  </div>
</div>

<!-- ═══ Nav ═══ -->
<nav id="nav">
  <button class="tab on" data-tab="list" onclick="switchTab('list')">
    <svg viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
    <span>在庫</span>
  </button>
  <button class="tab" data-tab="count" onclick="switchTab('count')">
    <svg viewBox="0 0 24 24"><path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2M7 12h10"/></svg>
    <span>棚卸</span>
  </button>
  <button class="tab" data-tab="label" onclick="switchTab('label')">
    <svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14h1M14 20h1M18 18h3v3h-3z"/></svg>
    <span>ラベル</span>
  </button>
</nav>

<!-- ═══ Sheets ═══ -->
<div id="sheet-bg" onclick="closeAllSheets()"></div>

<!-- 商品編集 -->
<div class="sheet" id="sheet-product">
  <div class="handle"></div>
  <h2 id="pe-title">商品を編集</h2>
  <div class="f-group"><div class="f-label">商品名</div><input class="f-input" id="pe-name"></div>
  <div class="f-row">
    <div class="f-group"><div class="f-label">商品コード</div><input class="f-input" id="pe-code"></div>
    <div class="f-group" style="max-width:110px;"><div class="f-label">単位</div><input class="f-input" id="pe-unit" placeholder="個"></div>
  </div>
  <div class="f-group"><div class="f-label">理論在庫（ネクストエンジン）</div><input class="f-input" id="pe-stock" type="number" inputmode="numeric"></div>
  <div class="f-group"><div class="f-label">カラー</div><div class="swatches" id="pe-swatches"></div></div>
  <div style="display:flex; flex-direction:column; gap:9px; margin-top:16px;">
