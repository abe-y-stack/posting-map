function saveHistory(){
  if (!S.route){ toast('先に計算してください', true); return; }
  const c=S.cfg, rt=c.round;
  const rec = {
    id: Date.now(), date: new Date().toISOString(),
    origin: S.origin ? S.origin.address : '(手入力)',
    dest:   S.dest   ? S.dest.address   : '(手入力)',
    mode: S.mode,
    distanceKm: S.route.distanceKm, durationMin: S.route.durationMin,
    originLat:S.origin?S.origin.lat:null, originLng:S.origin?S.origin.lng:null,
    destLat:S.dest?S.dest.lat:null,       destLng:S.dest?S.dest.lng:null
  };
  if (S.mode==='car'){
    const k = Core.carCost({distanceKm:S.route.distanceKm,fuelEff:c.eff,fuelPrice:c.price,
                            tollOneWay:S.tollOneWay,companyRate:c.rate,roundTrip:rt});
    rec.toll=k.toll; rec.fuel=k.fuel; rec.total=k.total;
  } else if (S.mode==='transit'){
    const k = Core.transitCost({fareOneWay:S.fareOneWay,roundTrip:rt});
    rec.fare=k.fare; rec.total=k.total;
  } else { rec.total=0; }

  const list = histStore.get(); list.unshift(rec);
  histStore.set(list.slice(0,100));
  renderList(); toast('履歴に保存しました');
}

function renderList(){
  const body=$('listBody'), acts=$('listActs');
  if (S.listTab==='hist'){
    const list=histStore.get();
    acts.style.display = list.length ? 'flex' : 'none';
    if(!list.length){ body.innerHTML='<div class="empty">履歴はまだありません</div>'; return; }
    body.innerHTML = list.map(h=>`
      <div class="item">
        <div class="item-main" data-rid="${h.id}">
          <div class="item-t">${esc(h.origin)} → ${esc(h.dest)}</div>
          <div class="item-s">${new Date(h.date).toLocaleDateString('ja-JP')}・${({car:'車',transit:'電車',walk:'徒歩',bike:'自転車'})[h.mode]}・${h.distanceKm??'—'}km・${Core.yen(h.total)}</div>
        </div>
        <button class="item-x" data-del="${h.id}">✕</button>
      </div>`).join('');
    body.querySelectorAll('[data-del]').forEach(b=> b.addEventListener('click',()=>{
      histStore.set(histStore.get().filter(x=>x.id!==Number(b.dataset.del))); renderList();
    }));
    body.querySelectorAll('[data-rid]').forEach(b=> b.addEventListener('click',()=> reuse(Number(b.dataset.rid))));
  } else {
    const list=favStore.get();
    acts.style.display='none';
    if(!list.length){ body.innerHTML='<div class="empty">お気に入りはまだありません</div>'; return; }
    body.innerHTML = list.map(f=>`
      <div class="item">
        <div class="item-main" data-fid="${f.id}">
          <div class="item-t">${esc(f.label)}</div>
          <div class="item-s">${esc(f.address)}</div>
        </div>
        <button class="item-x" data-fdel="${f.id}">✕</button>
      </div>`).join('');
    body.querySelectorAll('[data-fdel]').forEach(b=> b.addEventListener('click',()=>{
      favStore.set(favStore.get().filter(x=>x.id!==Number(b.dataset.fdel))); renderList();
    }));
    body.querySelectorAll('[data-fid]').forEach(b=> b.addEventListener('click',()=>{
      const f=favStore.get().find(x=>x.id===Number(b.dataset.fid)); if(!f) return;
      P.dest.setConfirmed({lat:f.lat,lng:f.lng,address:f.address});
      toast('訪問先に設定しました');
    }));
  }
}
function reuse(id){
  const h=histStore.get().find(x=>x.id===id); if(!h) return;
  if(h.originLat!=null) P.origin.setConfirmed({lat:h.originLat,lng:h.originLng,address:h.origin});
  if(h.destLat!=null)    P.dest.setConfirmed({lat:h.destLat,lng:h.destLng,address:h.dest});
  setMode(h.mode); toast('前回の条件を読み込みました');
}
function esc(s){ return String(s==null?'':s).replace(/[&<>"]/g, m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m])); }

/* =========================================================================
   検索実行
   ========================================================================= */
async function doSearch(){
  const btn=$('btnSearch'), txt=$('btnSearchTxt');

  // 未確定なら入力文字列から自動解決を試みる
  for (const [key,inputId,stId,label] of [['origin','inOrigin','stOrigin','出発地'],['dest','inDest','stDest','訪問先']]){
    if (S[key]) continue;
    const q = $(inputId).value.trim();
    if (!q){ toast(label+'を入力してください', true); return; }
    btn.classList.add('busy'); txt.textContent = label+'を特定中…';
    try{
      const list = await GeoService.search(q);
      if (!list.length){
        btn.classList.remove('busy'); txt.textContent='ルートを検索';
        P[key].setFailed('特定できません。候補から選ぶか、下の「距離を手入力」をご利用ください');
        toast(label+'の住所を特定できませんでした', true); return;
      }
      P[key].setConfirmed(list[0]);
    }catch(e){
      btn.classList.remove('busy'); txt.textContent='ルートを検索';
      P[key].setFailed('検索に失敗しました。「距離を手入力」もご利用ください：'+e.message);
      toast('住所検索に失敗しました。「距離を手入力」もご利用ください', true); return;
    }
  }

  btn.classList.add('busy'); btn.disabled=true; txt.textContent='ルート探索中…';
  try{
    const r = await RouteService.route(S.origin, S.dest, S.mode, S.cfg.avoidToll);
    S.route = r;
    MapView.draw(S.origin, S.dest, r.path);
    renderResult();
    if (r.source==='fallback') toast('経路探索に失敗したため直線距離からの概算です', true);
    else toast('ルートを取得しました');
  }catch(e){
    toast('検索に失敗しました：'+e.message, true);
  }finally{
    btn.classList.remove('busy'); btn.disabled=false; txt.textContent='ルートを検索';
  }
}

/* =========================================================================
   接続診断
   ========================================================================= */
async function runDiag(){
  const set=(id,ok,msg)=>{ const e=$(id); e.className = ok?'diag-ok':'diag-ng'; e.textContent = ok?'OK':('NG '+(msg||'')); };
  ['dgGsi','dgNom','dgOsrm','dgLeaf'].forEach(i=>{ $(i).className='diag-wait'; $(i).textContent='実行中…'; });
  $('diagNote').textContent='';

  try{ const j=await Net.json(`${GeoService.GSI}?q=${encodeURIComponent('東京都千代田区')}`,{timeout:9000});
       set('dgGsi', Core.normalizeGsi(j).length>0, '応答が空'); }
  catch(e){ set('dgGsi', false, e.message); }

  try{ const j=await Net.json(`${GeoService.NOM}?q=${encodeURIComponent('東京駅')}&format=json&limit=1&countrycodes=jp`,{timeout:9000});
       set('dgNom', Core.normalizeNominatim(j).length>0, '応答が空'); }
  catch(e){ set('dgNom', false, e.message); }

  try{ const j=await Net.json(`${RouteService.BASE}/driving/139.767,35.681;139.700,35.690?overview=false`,{timeout:9000});
       set('dgOsrm', j && j.code==='Ok', 'コード'+(j&&j.code)); }
  catch(e){ set('dgOsrm', false, e.message); }

  set('dgLeaf', typeof L !== 'undefined' && MapView.ok, '読込失敗');

  const isFile = location.protocol === 'file:';
  $('diagNote').textContent = isFile
    ? 'ファイルを直接開いています（file://）。この状態では外部APIがブラウザにブロックされます。GitHub Pages に置くか、ローカルサーバー経由で開いてください。'
    : 'NGが出た項目は、通信環境・社内プロキシ・拡張機能のブロックが原因の可能性があります。';
}

/* =========================================================================
   初期化 : リスナーは一度だけ登録する
   ========================================================================= */
function setMode(m){
  S.mode = m;
  document.querySelectorAll('#modeTabs .tab').forEach(b=> b.classList.toggle('on', b.dataset.mode===m));
  if (S.route) renderResult();
}
function readCfg(){
  S.cfg = {
    eff: Number($('cfgEff').value)||12,
    price: Number($('cfgPrice').value)||175,
    rate: $('cfgRate').value==='' ? null : Number($('cfgRate').value),
    round: $('cfgRound').checked,
    avoidToll: $('cfgAvoidToll').checked
  };
  cfgStore.set(S.cfg);
  if (S.route) renderResult();
}

function init(){
  // 設定を復元
  const c=S.cfg;
  $('cfgEff').value=c.eff; $('cfgPrice').value=c.price;
  $('cfgRate').value = c.rate==null?'':c.rate;
  $('cfgRound').checked=!!c.round; $('cfgAvoidToll').checked=!!c.avoidToll;
  ['cfgEff','cfgPrice','cfgRate','cfgRound','cfgAvoidToll'].forEach(id=> $(id).addEventListener('change', readCfg));

  P.origin = new Picker($('inOrigin'), $('candOrigin'), $('stOrigin'), c=>{ S.origin=c; });
  P.dest   = new Picker($('inDest'),   $('candDest'),   $('stDest'),   c=>{ S.dest=c; });

  $('btnSearch').addEventListener('click', doSearch);

  $('btnGps').addEventListener('click', async ()=>{
    if(!navigator.geolocation){ toast('この端末は位置情報に対応していません', true); return; }
    setStatus($('stOrigin'),'wait','現在地を取得中…');
    navigator.geolocation.getCurrentPosition(async p=>{
      const lat=p.coords.latitude, lng=p.coords.longitude;
      const addr= await GeoService.reverse(lat,lng);
      P.origin.setConfirmed({lat,lng,address:addr});
      toast('現在地を取得しました');
    }, err=>{
      P.origin.setFailed('現在地を取得できません（'+err.message+'）');
      toast('位置情報の取得に失敗しました', true);
    }, {enableHighAccuracy:true, timeout:12000});
  });

  document.querySelectorAll('#modeTabs .tab').forEach(b=> b.addEventListener('click', ()=> setMode(b.dataset.mode)));
  document.querySelectorAll('#listTabs .tab').forEach(b=> b.addEventListener('click', ()=>{
    S.listTab=b.dataset.list;
    document.querySelectorAll('#listTabs .tab').forEach(x=> x.classList.toggle('on', x===b));
    renderList();
  }));

  [['accVehicle','accVehicleBody'],['accManual','accManualBody']].forEach(([h,b])=>{
    $(h).addEventListener('click', ()=>{ $(h).classList.toggle('on'); $(b).classList.toggle('on'); });
  });

  $('btnManual').addEventListener('click', ()=>{
    const d=Number($('manDist').value);
    if(!d || d<=0){ toast('片道距離を入力してください', true); return; }
    const userMin = Number($('manMin').value) || null;
    const m = userMin || Core.estimateMinutes(d, (S.mode==='walk'||S.mode==='bike') ? S.mode : 'car');
    S.route={distanceKm:Math.round(d*10)/10, durationMin:Math.round(m), path:[], source:'manual', userMin};
    renderResult();
    toast('手入力の距離で計算しました');
    $('result').scrollIntoView({behavior:'smooth', block:'start'});
  });

  $('btnSettings').addEventListener('click', ()=> $('mdSettings').classList.add('on'));
  $('btnDiag').addEventListener('click', runDiag);
  document.querySelectorAll('[data-close]').forEach(b=> b.addEventListener('click', ()=> $(b.dataset.close).classList.remove('on')));
  document.querySelectorAll('.modal').forEach(m=> m.addEventListener('click', e=>{ if(e.target===m) m.classList.remove('on'); }));

  const openFav = which =>{
    const list=favStore.get();
    $('mdFavTitle').textContent = which==='o'?'出発地を選ぶ':'訪問先を選ぶ';
    $('mdFavList').innerHTML = list.length ? list.map(f=>`
      <div class="item"><div class="item-main" data-pick="${f.id}">
        <div class="item-t">${esc(f.label)}</div><div class="item-s">${esc(f.address)}</div>
      </div></div>`).join('') : '<div class="empty">お気に入りはまだありません</div>';
    $('mdFavList').querySelectorAll('[data-pick]').forEach(b=> b.addEventListener('click', ()=>{
      const f=list.find(x=>x.id===Number(b.dataset.pick)); if(!f) return;
      const loc={lat:f.lat,lng:f.lng,address:f.address};
      if(which==='o') P.origin.setConfirmed(loc); else P.dest.setConfirmed(loc);
      $('mdFav').classList.remove('on');
    }));
    $('mdFav').classList.add('on');
  };
  $('btnFavO').addEventListener('click', ()=> openFav('o'));
  $('btnFavD').addEventListener('click', ()=> openFav('d'));

  $('btnSaveFav').addEventListener('click', ()=>{
    const label=$('favLabel').value.trim(), addr=$('favAddr').value;
    if(!label){ toast('表示名を入力してください', true); return; }
    if(!S.dest){ toast('訪問先が未確定です', true); return; }
    const list=favStore.get();
    list.push({id:Date.now(), label, address:addr, lat:S.dest.lat, lng:S.dest.lng});
    favStore.set(list);
    $('mdAddFav').classList.remove('on'); renderList(); toast('お気に入りに登録しました');
  });

  $('btnCsv').addEventListener('click', ()=>{
    const list=histStore.get();
    if(!list.length){ toast('履歴がありません', true); return; }
    const csv='\uFEFF'+Core.buildCsv(Core.historyToRows(list));
    const blob=new Blob([csv],{type:'text/csv;charset=utf-8;'});
    const a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download=`交通費_${new Date().toISOString().slice(0,10)}.csv`;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(()=> URL.revokeObjectURL(a.href), 1000);
    toast('CSVをダウンロードしました');
  });

  $('btnClearHist').addEventListener('click', ()=>{
    if(confirm('履歴をすべて削除しますか？')){ histStore.set([]); renderList(); toast('履歴を削除しました'); }
  });

  MapView.init();
  renderList();

  if (location.protocol === 'file:'){
    toast('file:// で開いています。外部APIがブロックされる場合は設定→接続診断をご確認ください', true);
  }
}

if (typeof document !== 'undefined' && !globalThis.__TEST__){
  document.addEventListener('DOMContentLoaded', init);
}
if (typeof module !== 'undefined' && module.exports){ module.exports = { Core }; }
</script>
</body>
</html>
