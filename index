const $ = id => document.getElementById(id);
let toastTimer = null;
function toast(msg, ng){
  const t = $('toast');
  t.textContent = msg;
  t.className = 'toast on' + (ng ? ' ng' : '');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(()=> t.classList.remove('on'), 3800);
}
function setStatus(el, kind, text){
  el.className = 'status ' + kind;
  el.innerHTML = '<span class="dot"></span><span></span>';
  el.lastElementChild.textContent = text;
}

/* =========================================================================
   Map
   ========================================================================= */
const MapView = {
  map:null, line:null, m1:null, m2:null, ok:false,
  init(){
    if (this.map || typeof L === 'undefined') return;
    try{
      this.map = L.map('map', {scrollWheelZoom:false}).setView([35.925, 139.485], 10);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        {attribution:'© OpenStreetMap', maxZoom:19}).addTo(this.map);
      this.ok = true;
    }catch(e){ this.ok = false; }
  },
  draw(from, to, path){
    if (!this.map) this.init();
    if (!this.map) return;
    [this.line,this.m1,this.m2].forEach(l => { if (l) this.map.removeLayer(l); });
    this.m1 = L.marker([from.lat,from.lng]).addTo(this.map).bindPopup('出発地');
    this.m2 = L.marker([to.lat,to.lng]).addTo(this.map).bindPopup('訪問先');
    const pts = (path && path.length > 1) ? path : [[from.lat,from.lng],[to.lat,to.lng]];
    this.line = L.polyline(pts, {color:'#111', weight:4, opacity:.85}).addTo(this.map);
    this.map.fitBounds(this.line.getBounds(), {padding:[40,40]});
  }
};

/* =========================================================================
   Autocomplete
   ========================================================================= */
class Picker {
  constructor(input, box, status, onPick){
    this.input=input; this.box=box; this.status=status; this.onPick=onPick;
    this.timer=null; this.idx=-1; this.items=[]; this.seq=0;
    input.addEventListener('input', ()=> this.onInput());
    input.addEventListener('keydown', e=> this.onKey(e));
    input.addEventListener('blur', ()=> setTimeout(()=> this.close(), 200));
    input.addEventListener('focus', ()=>{ if(this.items.length) this.box.classList.add('on'); });
  }
  onInput(){
    clearTimeout(this.timer);
    this.seq++;                              // 進行中の検索結果を無効化
    this.onPick(null);                       // 手入力で確定を解除
    setStatus(this.status,'wait','未確定');
    const q = this.input.value.trim();
    if (q.length < 2){ this.close(); return; }
    setStatus(this.status,'wait','検索中…');
    this.timer = setTimeout(()=> this.run(q), 600);
  }
  async run(q){
    const my = ++this.seq;
    try{
      const list = await GeoService.search(q);
      if (my !== this.seq) return;           // 古い検索の結果は破棄
      this.items = list;
      this.render();
      if (!list.length) setStatus(this.status,'ng','候補が見つかりません。番地まで入力するか別の表記でお試しください');
      else setStatus(this.status,'wait','候補から選択してください');
    }catch(e){
      if (my !== this.seq) return;
      setStatus(this.status,'ng','検索に失敗しました：'+e.message);
    }
  }
  /** 外部（検索ボタン・お気に入り・履歴）から確定させる。保留中の検索を確実に打ち切る */
  setConfirmed(loc){
    clearTimeout(this.timer);
    this.seq++;
    this.items=[]; this.close();
    this.input.value = loc.address;
    this.onPick(loc);
    setStatus(this.status,'ok','確定：'+loc.address);
  }
  /** 外部から失敗状態にする。同じく保留中の検索を打ち切る */
  setFailed(msg){
    clearTimeout(this.timer);
    this.seq++;
    this.items=[]; this.close();
    setStatus(this.status,'ng',msg);
  }
  render(){
    this.box.innerHTML='';
    if (!this.items.length){
      this.box.innerHTML='<div class="cand-empty">候補なし</div>';
      this.box.classList.add('on'); return;
    }
    this.items.forEach((c,i)=>{
      const d=document.createElement('div');
      d.className='cand-item';
      d.innerHTML='<span></span><span class="cand-src"></span>';
      d.firstElementChild.textContent = c.address;
      d.lastElementChild.textContent = c.source;
      d.addEventListener('mousedown', e=>{ e.preventDefault(); this.pick(i); });
      this.box.appendChild(d);
    });
    this.box.classList.add('on'); this.idx=-1;
  }
  pick(i){
    const c=this.items[i]; if(!c) return;
    this.input.value = c.address;
    this.onPick(c);
    setStatus(this.status,'ok','確定：'+c.address);
    this.close();
  }
  onKey(e){
    const n=this.box.querySelectorAll('.cand-item');
    if(!n.length) return;
    if(e.key==='ArrowDown'){e.preventDefault(); this.idx=Math.min(this.idx+1,n.length-1); this.mark(n);}
    else if(e.key==='ArrowUp'){e.preventDefault(); this.idx=Math.max(this.idx-1,0); this.mark(n);}
    else if(e.key==='Enter'){ if(this.idx>=0){e.preventDefault(); this.pick(this.idx);} }
    else if(e.key==='Escape'){ this.close(); }
  }
  mark(n){ n.forEach((el,i)=> el.classList.toggle('sel', i===this.idx)); }
  close(){ this.box.classList.remove('on'); this.idx=-1; }
}

