<!-- 印刷エリア -->
<div id="print-area"><div class="pl-grid" id="pl-grid"></div></div>

<div id="toast"></div>

<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script>
'use strict';

/* ═══════════════ 状態 ═══════════════ */
const LS = { url: 'zaiko.gasUrl', cache: 'zaiko.cache', session: 'zaiko.session' };
const PALETTE = ['#5B7DA3','#7FA07C','#B8966E','#8A7A9B','#C08A6E','#7D8F8F','#B09A5C','#6E7B8A','#A96F6F','#6FA3A0','#9AA1A8','#A08A5E'];

let state = { products: [], labels: [] };
let gasUrl = localStorage.getItem(LS.url) || '';
let session = null;          // 棚卸セッション {id, startedAt, scanned:{labelId:true}, items:[{productCode,labelId,qty,method,name}]}

function prod(code) { return state.products.find(p => p.code === code); }
function $(id) { return document.getElementById(id); }

function toast(msg, ms = 2200) {
  const t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(t._tm); t._tm = setTimeout(() => t.classList.remove('show'), ms);
}

/* ═══════════════ API ═══════════════ */
async function api(action, payload = {}) {
  if (!gasUrl) return localApi(action, payload);
  if (action === 'getAll') {
    const r = await fetch(gasUrl + '?action=getAll');
    return r.json();
  }
  const r = await fetch(gasUrl, { method: 'POST', body: JSON.stringify(Object.assign({ action }, payload)) });
  return r.json();
}

/* 未接続時のローカル動作（この端末内のみ） */
function localApi(action, p) {
  switch (action) {
    case 'getAll': return Promise.resolve(Object.assign({ ok: true }, state));
    case 'saveProduct': {
      const i = state.products.findIndex(x => x.code === p.product.code);
      if (i >= 0) state.products[i] = Object.assign(state.products[i], p.product);
      else state.products.push(p.product);
      break;
    }
    case 'importProducts': {
      p.products.forEach(n => {
        const e = prod(n.code);
        if (e) { e.name = n.name; e.stock = n.stock; }
        else state.products.push(n);
      });
      break;
    }
    case 'deleteProduct':
      state.products = state.products.filter(x => x.code !== p.code);
      break;
    case 'createLabels': {
      const base = Date.now().toString(36).toUpperCase();
      const created = [];
      p.qtyList.forEach((qty, i) => {
        const l = { labelId: 'L' + base + '-' + (i + 1), productCode: p.productCode, qty, active: true };
        state.labels.push(l); created.push(l);
      });
      cacheSave();
      return Promise.resolve({ ok: true, labels: created });
    }
    case 'deactivateLabel':
      state.labels = state.labels.filter(l => l.labelId !== p.labelId);
      break;
    case 'submitInventory':
      if (p.apply) {
        const totals = {};
        p.items.forEach(it => totals[it.productCode] = (totals[it.productCode] || 0) + Number(it.qty));
        state.products.forEach(pr => { if (totals[pr.code] !== undefined) pr.stock = totals[pr.code]; });
      }
      break;
  }
  cacheSave();
  return Promise.resolve({ ok: true });
}

function cacheSave() {
  localStorage.setItem(LS.cache, JSON.stringify(state));
}
function cacheLoad() {
  try {
    const c = JSON.parse(localStorage.getItem(LS.cache));
    if (c && c.products) state = Object.assign(state, c);
  } catch (e) {}
}

async function reloadData() {
  if (!gasUrl) { toast('未接続（端末内モード）'); renderAll(); return; }
  setConn(false, '同期中…');
  try {
    const r = await api('getAll');
    if (!r.ok) throw new Error(r.error);
    state.products = r.products || [];
    state.labels = r.labels || [];
    state.products.forEach(p => p.stock = Number(p.stock) || 0);
    cacheSave();
    setConn(true, '接続済み');
    renderAll();
    toast('データを読み込みました');
  } catch (e) {
    setConn(false, '接続エラー');
    toast('読み込みに失敗しました');
    console.error(e);
  }
}
function setConn(on, tx) {
  $('conn').classList.toggle('on', on);
  $('conn-tx').textContent = tx;
}

/* ═══════════════ タブ・シート ═══════════════ */
function switchTab(id) {
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.tab').forEach(t => t.classList.toggle('on', t.dataset.tab === id));
  $('panel-' + id).classList.add('active');
  if (id !== 'count' && camStream && !session) stopCamera();
}
function openSheet(id) { $('sheet-bg').classList.add('show'); $(id).classList.add('show'); }
function closeAllSheets() {
  $('sheet-bg').classList.remove('show');
  document.querySelectorAll('.sheet').forEach(s => s.classList.remove('show'));
}

/* ═══════════════ 在庫一覧 ═══════════════ */
function productRowHtml(p) {
  return `
  <div class="row" onclick="openProductEdit('${escq(p.code)}')">
    <div class="swatch" style="background:${p.color}"></div>
    <div class="meta">
      <div class="nm">${esc(p.name)}</div>
      <div class="cd">${esc(p.code)}</div>
    </div>
    <div class="num"><b>${p.stock}</b><span>${esc(p.unit || '個')}</span></div>
    <div class="chev">›</div>
  </div>`;
}
function esc(s) { return String(s ?? '').replace(/[&<>"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c])); }
function escq(s) { return String(s).replace(/'/g, "\\'").replace(/"/g, '&quot;'); }

function filterProducts(q) {
  q = (q || '').trim().toLowerCase();
  if (!q) return state.products;
  return state.products.filter(p =>
    (p.name || '').toLowerCase().includes(q) || (p.code || '').toLowerCase().includes(q));
}

function renderList() {
  const list = filterProducts($('list-search').value);
  $('list-count-label').textContent = `商品（${list.length}件）`;
  $('list-el').innerHTML = list.map(p => productRowHtml(p)).join('') ||
    '<div style="padding:26px; text-align:center; color:var(--t2); font-size:13px;">商品がありません。CSVインポートから登録してください。</div>';
}
/* ═══════════════ CSVインポート ═══════════════ */
async function importCsv(file) {
  if (!file) return;
  const buf = await file.arrayBuffer();
  let text;
  try { text = new TextDecoder('shift_jis', { fatal: true }).decode(buf); }
  catch (e) { text = new TextDecoder('utf-8').decode(buf); }
  const rows = parseCsv(text);
  if (!rows.length) { toast('CSVを読み込めませんでした'); return; }
  const head = rows[0];
  const iName = head.indexOf('商品名');
  const iCode = head.indexOf('商品コード');
  const iStock = head.findIndex(h => h.startsWith('在庫数'));
  if (iName < 0 || iCode < 0 || iStock < 0) { toast('列（商品名・商品コード・在庫数）が見つかりません'); return; }
  const existing = new Set(state.products.map(p => p.code));
  let ci = state.products.length;
  const list = [];
  for (let i = 1; i < rows.length; i++) {
    const r = rows[i];
    if (!r[iCode]) continue;
    const code = r[iCode].trim();
    list.push({
      code,
      name: (r[iName] || '').trim(),
      stock: Number(r[iStock]) || 0,
      color: existing.has(code) ? undefined : PALETTE[(ci++) % PALETTE.length],
      unit: '個',
    });
  }
  toast('取込中…（' + list.length + '件）', 5000);
  const res = await api('importProducts', { products: list });
  if (res.products) {
    state.products = res.products;
    state.products.forEach(p => p.stock = Number(p.stock) || 0);
  }
  cacheSave();
  renderAll();
  toast(`取込完了：新規${res.added ?? '-'}件 / 更新${res.updated ?? '-'}件`);
  $('csv-file').value = '';
}

function parseCsv(text) {
  const rows = []; let row = [], cur = '', inQ = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (inQ) {
      if (c === '"') { if (text[i + 1] === '"') { cur += '"'; i++; } else inQ = false; }
      else cur += c;
    } else {
      if (c === '"') inQ = true;
      else if (c === ',') { row.push(cur); cur = ''; }
      else if (c === '\n' || c === '\r') {
        if (c === '\r' && text[i + 1] === '\n') i++;
        row.push(cur); cur = '';
        if (row.some(v => v !== '')) rows.push(row);
        row = [];
      } else cur += c;
    }
  }
  row.push(cur);
  if (row.some(v => v !== '')) rows.push(row);
  return rows;
}

/* ═══════════════ 商品編集 ═══════════════ */
let editing = null;
function openProductEdit(code) {
  const p = code ? prod(code) : null;
  editing = { originalCode: code };
  $('pe-title').textContent = p ? '商品を編集' : '商品を追加';
  $('pe-name').value = p ? p.name : '';
  $('pe-code').value = p ? p.code : '';
  $('pe-unit').value = p ? (p.unit || '個') : '個';
  $('pe-stock').value = p ? p.stock : 0;
  $('pe-delete').style.display = p ? 'block' : 'none';
  const sel = p ? p.color : PALETTE[state.products.length % PALETTE.length];
  $('pe-swatches').innerHTML = PALETTE.map(c =>
    `<button class="sw ${c === sel ? 'sel' : ''}" style="background:${c}" data-c="${c}" onclick="selSwatch(this)"></button>`).join('');
  openSheet('sheet-product');
}
function selSwatch(el) {
  document.querySelectorAll('#pe-swatches .sw').forEach(s => s.classList.remove('sel'));
  el.classList.add('sel');
}
async function saveProductEdit() {
  const code = $('pe-code').value.trim();
  const name = $('pe-name').value.trim();
  if (!code || !name) { toast('商品名とコードを入力してください'); return; }
  const color = document.querySelector('#pe-swatches .sw.sel')?.dataset.c || PALETTE[0];
  const p = {
    code, name, color,
    unit: $('pe-unit').value.trim() || '個',
    stock: Number($('pe-stock').value) || 0,
  };
  closeAllSheets();
  toast('保存中…', 4000);
  await api('saveProduct', { product: p });
  const i = state.products.findIndex(x => x.code === code);
  if (i >= 0) state.products[i] = Object.assign(state.products[i], p); else state.products.push(p);
  cacheSave();
  renderAll();
  toast('保存しました');
}
async function deleteProductAction() {
  if (!editing.originalCode) return;
  if (!confirm('この商品を削除しますか？')) return;
  closeAllSheets();
  await api('deleteProduct', { code: editing.originalCode });
  state.products = state.products.filter(p => p.code !== editing.originalCode);
  cacheSave();
  renderAll();
  toast('削除しました');
}
/* ═══════════════ 商品ピッカー ═══════════════ */
let pickerCb = null;
function pickProduct(cb) {
  pickerCb = cb;
  $('picker-search').value = '';
  renderPicker();
  openSheet('sheet-picker');
}
function renderPicker() {
  const list = filterProducts($('picker-search').value).slice(0, 60);
  $('picker-list').innerHTML = list.map(p => `
    <div class="row" onclick="pickerChoose('${escq(p.code)}')">
      <div class="swatch" style="background:${p.color}"></div>
      <div class="meta"><div class="nm">${esc(p.name)}</div><div class="cd">${esc(p.code)}</div></div>
      <div class="num"><b>${p.stock}</b><span>${esc(p.unit || '個')}</span></div>
    </div>`).join('');
}
function pickerChoose(code) {
  closeAllSheets();
  if (pickerCb) pickerCb(prod(code));
  pickerCb = null;
}

/* ═══════════════ 棚卸 ═══════════════ */
let camStream = null, scanLoop = null, lastScan = {};

function loadSession() {
  try { session = JSON.parse(localStorage.getItem(LS.session)); } catch (e) { session = null; }
  if (session && !session.items) session = null;
  $('resume-box').style.display = session ? 'block' : 'none';
}
function persistSession() {
  if (session) localStorage.setItem(LS.session, JSON.stringify(session));
  else localStorage.removeItem(LS.session);
}
function startSession() {
  session = { id: 'S' + Date.now(), startedAt: new Date().toISOString(), scanned: {}, items: [] };
  persistSession();
  showLive();
}
function resumeSession() { showLive(); }
function showLive() {
  $('scan-idle').style.display = 'none';
  $('scan-live').style.display = 'block';
  renderTally();
  startCamera();
}
function cancelSession() {
  if (!confirm('カウント内容を破棄して中断しますか？')) return;
  session = null;
  persistSession();
  stopCamera();
  $('scan-live').style.display = 'none';
  $('scan-idle').style.display = 'block';
  $('resume-box').style.display = 'none';
}

async function startCamera() {
  if (camStream) return;
  try {
    camStream = await navigator.mediaDevices.getUserMedia({
      video: { facingMode: { ideal: 'environment' }, width: { ideal: 1280 } }, audio: false,
    });
    const v = $('cam');
    v.srcObject = camStream;
    await v.play();
    $('cam-off-msg').style.display = 'none';
    $('cam-toggle').textContent = 'カメラ停止';
    scanTick();
  } catch (e) {
    toast('カメラを起動できません（権限を確認してください）', 3200);
    $('cam-off-msg').style.display = 'flex';
  }
}
function stopCamera() {
  if (scanLoop) cancelAnimationFrame(scanLoop);
  scanLoop = null;
  if (camStream) { camStream.getTracks().forEach(t => t.stop()); camStream = null; }
  $('cam-off-msg').style.display = 'flex';
  $('cam-toggle').textContent = 'カメラ再開';
}
function toggleCamera() { camStream ? stopCamera() : startCamera(); }

const scanCanvas = document.createElement('canvas');
let jsQrMissingWarned = false;
function scanTick() {
  scanLoop = requestAnimationFrame(scanTick);
  const v = $('cam');
  if (!camStream || v.readyState < 2) return;
  if (typeof jsQR !== 'function') {
    if (!jsQrMissingWarned) { jsQrMissingWarned = true; toast('QR読取ライブラリの読込に失敗しました。通信環境を確認して再読込してください', 4000); }
    return;
  }
  try {
    const w = 480, h = Math.round(480 * v.videoHeight / v.videoWidth) || 360;
    scanCanvas.width = w; scanCanvas.height = h;
    const ctx = scanCanvas.getContext('2d', { willReadFrequently: true });
    ctx.drawImage(v, 0, 0, w, h);
    const img = ctx.getImageData(0, 0, w, h);
    const code = jsQR(img.data, w, h, { inversionAttempts: 'dontInvert' });
    if (code && code.data) handleScan(code.data.trim());
  } catch (err) {
    console.error('scan error', err);
  }
}

function handleScan(text) {
  const now = Date.now();
  if (lastScan[text] && now - lastScan[text] < 2600) return; // 同一QR連続読み防止
  lastScan[text] = now;

  const parts = text.split('|');
  if (parts[0] !== 'OKD' || parts.length < 4) { toast('対象外のQRコードです'); buzz(false); return; }
  const [, code, qtyS, labelId] = parts;
  const qty = Number(qtyS);
  const p = prod(code);
  if (!p) { toast('未登録の商品コード: ' + code, 3000); buzz(false); return; }
  if (session.scanned[labelId]) {
    toast('⚠ この箱はスキャン済みです（' + p.name + '）', 3000);
    buzz(false);
    return;
  }
  session.scanned[labelId] = true;
  session.items.push({ productCode: code, labelId, qty, method: 'scan', name: p.name });
  persistSession();
  flash();
  buzz(true);
  toast(p.name + ' ＋' + qty + (p.unit || '個'));
  renderTally();
}

function flash() {
  const f = $('cam-flash');
  f.style.opacity = '0.7';
  setTimeout(() => f.style.opacity = '0', 130);
}
let audioCtx = null;
function buzz(ok) {
  try { if (navigator.vibrate) navigator.vibrate(ok ? 60 : [80, 60, 80]); } catch (e) {}
  try {
    audioCtx = audioCtx || new (window.AudioContext || window.webkitAudioContext)();
    const o = audioCtx.createOscillator(), g = audioCtx.createGain();
    o.connect(g); g.connect(audioCtx.destination);
    o.frequency.value = ok ? 1320 : 260;
    g.gain.setValueAtTime(0.12, audioCtx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + 0.18);
    o.start(); o.stop(audioCtx.currentTime + 0.19);
  } catch (e) {}
}

/* 手入力（バラ用）: 式入力＋タリーカウンター */
let manualProduct = null;
function manualAdd() {
  pickProduct(p => {
    manualProduct = p;
    $('qty-product-label').textContent = p.name;
    $('qty-unit').textContent = p.unit || '個';
    $('qty-input').value = '';
    updateQtyTotal();
    openSheet('sheet-qty');
  });
}
/* 数式の安全評価（数字と + - * / ( ) . のみ許可） */
function evalQty(exp) {
  if (!exp) return 0;
  exp = String(exp)
    .replace(/[０-９]/g, c => String.fromCharCode(c.charCodeAt(0) - 0xFEE0))
    .replace(/×/g, '*').replace(/÷/g, '/').replace(/[＋]/g, '+').replace(/[－ー]/g, '-')
    .replace(/[（]/g, '(').replace(/[）]/g, ')')
    .replace(/\s/g, '');
  if (!/^[0-9+\-*/().]+$/.test(exp)) return NaN;
  try {
    const v = Function('"use strict";return(' + exp + ')')();
    return (typeof v === 'number' && isFinite(v)) ? v : NaN;
  } catch (e) { return NaN; }
}
function updateQtyTotal() {
  const v = evalQty($('qty-input').value);
  const el = $('qty-total');
  el.textContent = isNaN(v) ? '—' : Math.round(v);
  el.style.color = isNaN(v) ? 'var(--bad)' : 'var(--t1)';
}
function qtyBump(n) {
  const cur = $('qty-input').value.trim();
  $('qty-input').value = cur ? cur + '+' + n : String(n);
  updateQtyTotal();
  try { if (navigator.vibrate) navigator.vibrate(25); } catch (e) {}
}
function qtyClear() {
  $('qty-input').value = '';
  updateQtyTotal();
}
function confirmManualQty() {
  const raw = $('qty-input').value;
  const q = Math.round(evalQty(raw));
  if (!manualProduct || isNaN(q) || q < 1) { toast('数量または式を確認してください'); return; }
  session.items.push({ productCode: manualProduct.code, labelId: '', qty: q, method: 'manual', name: manualProduct.name, note: raw.trim() });
  persistSession();
  closeAllSheets();
  toast(manualProduct.name + ' ＋' + q + (manualProduct.unit || '個'));
  renderTally();
}

function tallyTotals() {
  const t = {};
  (session?.items || []).forEach(it => t[it.productCode] = (t[it.productCode] || 0) + Number(it.qty));
  return t;
}
function renderTally() {
  if (!session) return;
  const totals = tallyTotals();
  const codes = Object.keys(totals);
  $('tally-n').textContent = codes.length + '品目 / ' + session.items.length + '件';
  $('tally-el').innerHTML = codes.map(c => {
    const p = prod(c) || { name: c, stock: 0, unit: '個' };
    const diff = totals[c] - (Number(p.stock) || 0);
    const cls = diff === 0 ? 'zero' : diff > 0 ? 'plus' : 'minus';
    const dx = diff === 0 ? '±0' : (diff > 0 ? '+' + diff : diff);
    return `<div class="tally-row">
      <div class="meta"><div class="nm">${esc(p.name)}</div><div class="cd">${esc(c)}</div></div>
      <div><span class="cnt">${totals[c]}</span> <span class="vs">/ ${p.stock}</span></div>
      <div class="diff-chip ${cls}">${dx}</div>
    </div>`;
  }).join('') || '<div style="padding:20px; text-align:center; color:var(--t2); font-size:13px;">まだカウントがありません</div>';

  const hist = session.items.slice(-15).reverse();
  $('hist-el').innerHTML = hist.map((it, ri) => {
    const idx = session.items.length - 1 - ri;
    const note = it.note && it.note !== String(it.qty) ? ` <span style="color:var(--t3)">(${esc(it.note)})</span>` : '';
    return `<div class="hist-row">
      <div class="m">${it.method === 'manual' ? '✎' : '⌁'} ${esc(it.name)}${note}</div>
      <div class="q">＋${it.qty}</div>
      <button class="del" onclick="removeItem(${idx})">取消</button>
    </div>`;
  }).join('') || '<div style="padding:16px; text-align:center; color:var(--t2); font-size:12px;">履歴なし</div>';
}
function removeItem(idx) {
  const it = session.items[idx];
  if (!it) return;
  if (it.labelId) delete session.scanned[it.labelId];
  session.items.splice(idx, 1);
  persistSession();
  renderTally();
  toast('取り消しました');
}

/* 完了・サマリー */
function openSummary() {
  if (!session || !session.items.length) { toast('カウントがありません'); return; }
  renderSummary();
  $('sum-include-zero').onchange = renderSummary;
  openSheet('sheet-summary');
}
function summaryRows() {
  const totals = tallyTotals();
  const includeZero = $('sum-include-zero').checked;
  const rows = [];
  state.products.forEach(p => {
    const counted = totals[p.code];
    if (counted === undefined && !includeZero) return;
    const real = counted ?? 0;
    rows.push({ code: p.code, name: p.name, stock: Number(p.stock) || 0, real, diff: real - (Number(p.stock) || 0) });
  });
  // マスタに無いコード（念のため）
  Object.keys(totals).forEach(c => {
    if (!prod(c)) rows.push({ code: c, name: c, stock: 0, real: totals[c], diff: totals[c] });
  });
  return rows;
}
function renderSummary() {
  const rows = summaryRows();
  $('sum-body').innerHTML = rows.map(r => {
    const cls = r.diff === 0 ? 'zero' : r.diff > 0 ? 'plus' : 'minus';
    const dx = r.diff === 0 ? '±0' : (r.diff > 0 ? '+' + r.diff : r.diff);
    return `<tr><td>${esc(r.name)}</td><td>${r.stock}</td><td><b>${r.real}</b></td><td><span class="diff-chip ${cls}">${dx}</span></td></tr>`;
  }).join('');
}
async function finishSession(withCsv) {
  const rows = summaryRows();
  const apply = $('sum-apply').checked;
  closeAllSheets();
  toast('保存中…', 5000);
  try {
    const sendItems = session.items.map(it => ({
      productCode: it.productCode, labelId: it.labelId, qty: it.qty,
      method: it.method + (it.note && it.note !== String(it.qty) ? '(' + it.note + ')' : ''),
    }));
    await api('submitInventory', { sessionId: session.id, items: sendItems, apply });
    if (apply) {
      const totals = tallyTotals();
      state.products.forEach(p => { if (totals[p.code] !== undefined) p.stock = totals[p.code]; });
      cacheSave();
    }
    if (withCsv) exportDiffCsv(rows);
    stopCamera();
    session = null;
    persistSession();
    $('scan-live').style.display = 'none';
    $('scan-idle').style.display = 'block';
    $('resume-box').style.display = 'none';
    renderAll();
    toast('棚卸を保存しました');
  } catch (e) {
    toast('保存に失敗しました（電波状況を確認して再度完了してください）', 3600);
  }
}
function exportDiffCsv(rows) {
  const d = new Date();
  const pad = n => String(n).padStart(2, '0');
  const stamp = `${d.getFullYear()}${pad(d.getMonth() + 1)}${pad(d.getDate())}`;
  const lines = [['商品コード','商品名','理論在庫','実棚数','差異(増減)']];
  rows.forEach(r => lines.push([r.code, r.name, r.stock, r.real, r.diff]));
  const csv = '\uFEFF' + lines.map(l => l.map(v => '"' + String(v).replace(/"/g, '""') + '"').join(',')).join('\r\n');
  const blob = new Blob([csv], { type: 'text/csv' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `tanaoroshi_sai_${stamp}.csv`;
  a.click();
  URL.revokeObjectURL(a.href);
}

/* ═══════════════ ラベル ═══════════════ */
let labelProduct = null;
let labelMode = 'uniform'; // 'uniform' | 'custom'
function setLabelProduct(p) {
  labelProduct = p;
  const btn = $('lb-product-btn');
  btn.textContent = p.name;
  btn.style.color = 'var(--t1)';
}
function setLabelMode(mode) {
  labelMode = mode;
  $('lb-mode-uniform').style.background = mode === 'uniform' ? 'var(--t1)' : '';
  $('lb-mode-uniform').style.color = mode === 'uniform' ? '#fff' : '';
  $('lb-mode-custom').style.background = mode === 'custom' ? 'var(--t1)' : '';
  $('lb-mode-custom').style.color = mode === 'custom' ? '#fff' : '';
  $('lb-uniform-fields').style.display = mode === 'uniform' ? 'block' : 'none';
  $('lb-custom-fields').style.display = mode === 'custom' ? 'block' : 'none';
}
function parseQtyList(text) {
  return (text || '')
    .split(/[,、\n]/)
    .map(s => s.trim())
    .filter(s => s !== '')
    .map(s => Number(s.replace(/[０-９]/g, c => String.fromCharCode(c.charCodeAt(0) - 0xFEE0))))
    .filter(n => Number.isFinite(n) && n > 0);
}
function renderLbPreview() {
  const list = parseQtyList($('lb-list').value);
  if (!list.length) { $('lb-preview').textContent = ''; return; }
  const total = list.reduce((a, b) => a + b, 0);
  $('lb-preview').textContent = `${list.length}箱・合計 ${total} → [${list.join(', ')}]`;
}
function autoSplitLabels() {
  const total = Number($('lb-total').value);
  const std = Number($('lb-std').value);
  if (!total || !std || std < 1) { toast('合計と標準入数を入力してください'); return; }
  const full = Math.floor(total / std);
  const rem = total - full * std;
  const list = Array(full).fill(std);
  if (rem > 0) list.push(rem);
  $('lb-list').value = list.join(',');
  renderLbPreview();
}
async function createLabelsAction() {
  if (!labelProduct) { toast('商品を選択してください'); return; }
  let qtyList;
  if (labelMode === 'uniform') {
    const qty = Number($('lb-qty').value);
    const count = Number($('lb-count').value);
    if (!qty || qty < 1) { toast('入数を入力してください'); return; }
    if (!count || count < 1) { toast('枚数を入力してください'); return; }
    qtyList = Array(count).fill(qty);
  } else {
    qtyList = parseQtyList($('lb-list').value);
    if (!qtyList.length) { toast('箱ごとの入数を入力してください'); return; }
  }
  toast('発行中…', 4000);
  const res = await api('createLabels', { productCode: labelProduct.code, qtyList });
  if (!res.ok) { toast('発行に失敗しました'); return; }
  if (gasUrl) state.labels = state.labels.concat(res.labels);
  cacheSave();
  renderLabels();
  printLabels(res.labels);
}

function renderLabels() {
  const q = ($('label-search').value || '').trim().toLowerCase();
  const list = state.labels.filter(l => {
    const p = prod(l.productCode);
    if (!q) return true;
    return (p?.name || '').toLowerCase().includes(q) || l.productCode.toLowerCase().includes(q);
  });
  $('labels-el').innerHTML = list.slice().reverse().map(l => {
    const p = prod(l.productCode) || { name: l.productCode };
    return `<div class="label-card">
      <input type="checkbox" data-label="${esc(l.labelId)}">
      <div class="meta">
        <div class="nm">${esc(p.name)}</div>
        <div class="sub">入数 ${l.qty}${esc(p.unit || '個')}　${esc(l.labelId)}</div>
      </div>
      <button class="void" onclick="voidLabel('${escq(l.labelId)}')">無効化</button>
    </div>`;
  }).join('') || '<div style="padding:20px; text-align:center; color:var(--t2); font-size:13px;">発行済みラベルはありません</div>';
}
async function voidLabel(labelId) {
  if (!confirm('このラベルを無効化しますか？（スキャンしても加算されなくなります）')) return;
  await api('deactivateLabel', { labelId });
  state.labels = state.labels.filter(l => l.labelId !== labelId);
  cacheSave();
  renderLabels();
  toast('無効化しました');
}
function printSelectedLabels() {
  const ids = Array.from(document.querySelectorAll('#labels-el input:checked')).map(c => c.dataset.label);
  if (!ids.length) { toast('印刷するラベルを選択してください'); return; }
  printLabels(state.labels.filter(l => ids.includes(l.labelId)));
}
function printLabels(labels) {
  const grid = $('pl-grid');
  grid.innerHTML = '';
  labels.forEach(l => {
    const p = prod(l.productCode) || { name: l.productCode, unit: '個' };
    const cell = document.createElement('div');
    cell.className = 'pl';
    cell.innerHTML = `
      <div class="qr"></div>
      <div class="tx">
        <div class="n">${esc(p.name)}</div>
        <div class="c">${esc(l.productCode)}</div>
        <div class="q">入数 ${l.qty}${esc(p.unit || '個')}</div>
        <div class="id">${esc(l.labelId)}</div>
      </div>`;
    grid.appendChild(cell);
    new QRCode(cell.querySelector('.qr'), {
      text: `OKD|${l.productCode}|${l.qty}|${l.labelId}`,
      width: 220, height: 220,
      correctLevel: QRCode.CorrectLevel.M,
    });
  });
  setTimeout(() => window.print(), 400);
}

/* ═══════════════ 設定 ═══════════════ */
function openSettings() {
  $('st-url').value = gasUrl;
  openSheet('sheet-settings');
}
async function saveSettings() {
  gasUrl = $('st-url').value.trim();
  localStorage.setItem(LS.url, gasUrl);
  closeAllSheets();
  if (gasUrl) await reloadData();
  else { cacheSave(); setConn(false, '未接続'); renderAll(); }
}

/* ═══════════════ 起動 ═══════════════ */
function renderAll() {
  renderList();
  renderLabels();
}
cacheLoad();
loadSession();
renderAll();
if (gasUrl) reloadData(); else setConn(false, '未接続（端末内）');
</script>
